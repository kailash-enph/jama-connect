# Jama Connect OAuth2 credentials (required)
JAMA_URL=https://enphase.jamacloud.com
JAMA_CLIENT_ID=your-client-id-here
JAMA_CLIENT_SECRET=your-client-secret-here

# Project IDs to sync (comma-separated). Use "all" to sync all accessible projects.
JAMA_PROJECTS=20570

# Output directory for generated .db.gz files (must be writable by this script)
SERVE_DIR=./data

# Port for nginx (only used by docker-compose.yml)
SERVE_PORT=8866
