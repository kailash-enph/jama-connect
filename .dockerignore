# ── Node / build artifacts ────────────────────────────────────────────────────
client/vscode-extension/node_modules
client/vscode-extension/out
client/viewer/node_modules
client/viewer/.next
client/viewer/out

# ── Python virtualenvs & cache ───────────────────────────────────────────────
client/backend/.venv
**/__pycache__
**/*.pyc
**/*.pyo
